{
    //
    // Multiform Test
    //
    $controller: "FormMultiForm",
    $namespace: "TestApp",
    $use: ["TestApp.Controls"],
    $content: [
        {
            $controller: "ScrollViewer",
            $layout: "Column",
            scrollMode: "vertical",
            $content: [
                {
                    $controller: "ControlCard",
                    title: "Attack of the Pogačar",
                    description: "A story about Pogačar, the champion bicyclist!",
                    byLine: "By the Pogačar crowd"
                },
                {
                    $controller: "ControlCard",
                    title: "Attack of the Vingegaard",
                    description: "A story about Vingegaard, the champion bicyclist!",
                    byLine: "By the Vingegaard crowd"
                },
                {
                    $controller: "MyCard",
                    title: "Attack of the Cavendish",
                    description: "A story about Cavendish, the champion bicyclist!",
                    byLine: "By the Cavendish crowd",

                    // TBD: This does not work
                    card1: {
                        description: "Card 1 description!",
                        byLine: "Card 1 byline!"
                    }
                },
                {
                    $controller: "Panel",
                    $borderRadius: 10.0,
                    $borderWidth: 2.0,
                    $borderColor: "Navy",
                    $padding: "left:15,top:15,right:15,bottom:15",
                    $content: [
                        {
                            $controller: "FormSmallWinTest"
                        }
                    ]
                },
                {
                    $controller: "Panel",
                    $borderRadius: 10.0,
                    $borderWidth: 2.0,
                    $borderColor: "Green",
                    $padding: "left:15,top:15,right:15,bottom:15",
                    $content: [
                        {
                            $controller: "FormSearch"
                        }
                    ]
                }
            ]
        }
    ]
}