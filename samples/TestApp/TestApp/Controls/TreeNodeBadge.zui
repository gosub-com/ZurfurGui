// Tree node that shows a badge label and a text label side by side.
// This is an example of a custom node.  It implements ITreeNode through $implements and is
// used as TreeView<TreeNodeBadge>.
{
    $controller: "TreeNodeBadge",
    $namespace: "TestApp.Test.Controls",
    $use: ["ZurfurGui.Controls.TreeView"],
    $implements: "ITreeNode<TreeNodeBadgeData>",
    $padding: "${spacing.horizontal.small | spacing.vertical.extra-small}",
    $layout: "Row",
    $data: {
        children: {
            type: "[]TreeNodeBadge",
            bind: "data"
        },
        isExpanded: {
            type: "Bool",
            bind: "data"
        },
        isSelected: {
            type: "Bool",
            bind: "data"
        },
        // Short label shown inside the red-outlined badge pill.
        badge: {
            type: "TextLines",
            bind: "data:_badge.text"
        },
        // Main descriptive text shown to the right of the badge.
        text: {
            type: "TextLines",
            bind: "data:_text.text"
        }
    },
    $content: [
        {
            $borderWidth: "${stroke.width.medium}",
            $borderColor: "${color.status.danger.stroke}",
            $borderRadius: "${radius.corner.small}",
            $padding: "${spacing.vertical.extra-small | spacing.horizontal.small}",
            $align: "vertical:center",
            $content: [
                {
                    $name: "_badge",
                    $controller: "TextView",
                    TextView.color: "${color.status.danger.stroke}"
                }
            ]
        },
        {
            $name: "_text",
            $controller: "TextView",
            TextView.color: "${color.text.primary}",
            $padding: "left:8,top:0,right:0,bottom:0"
        }
    ]
}
