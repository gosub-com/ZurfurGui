{
    $controller: "ControlCard",
    $namespace: "TestApp.Controls",
    $layout: "Column",
    $data: {
        title: {
            type: "TextLines",
            bind: "data:_title.text"
        },
        description: {
            type: "TextLines",
            bind: "data:_description.text"
        },
        byLine: {
            type: "TextLines",
            bind: "data:_byline.text"
        }
    },
    $content: [
        {
            $controller: "TextView",
            $name: "_title",
            text: "Default control card title",
            font: "size:24"
        },
        {
            $controller: "TextView",
            $name: "_description",
            text: "Defaut control card description. "
        },
        {
            $controller: "TextView",
            $name: "_byline",
            text: "Default control card byline",
            font: "size:12"
        }
    ]
}
