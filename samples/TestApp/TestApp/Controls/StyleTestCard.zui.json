{
    ".controller": "StyleTestCard",
    ".namespace": "TestApp.Controls",
    ".layout": "Column",
    ".content": [
        {
            // Show theme name using the StyleTestSkinHoverTextStyleTestSkinHoverText style
            ".controller": "TextView",
            ".name": "debugLabel",
            "TextView.text": "${style.test.text.hover-nothover}",

            ".borderWidth": 2,
            ".borderColor": "Gray"
        },
        {
            ".controller": "TextView",
            ".borderWidth": 2,
            ".borderColor": "Gray",
            "text": "StyleNone"
        },
        {
            ".controller": "TextView",
            ".sizeRequest": "${style.test.sizeRequest.c1}",
            "TextView.font": "${style.test.font.c1}",
            ".borderWidth": 2,
            ".borderColor": "Gray",
            "text": "Style C1"
        },
        {
            ".controller": "TextView",
            ".sizeRequest": "${style.test.sizeRequest.c2}",
            "TextView.font": "${style.test.font.c2}",
            ".borderWidth": 2,
            ".borderColor": "Gray",
            "text": "Style C2"
        },
        {
            ".controller": "TextView",
            ".sizeRequest": "${style.test.sizeRequest.c1 | style.test.sizeRequest.c2}",
            "TextView.font": "${style.test.font.c1 | style.test.font.c2}",
            ".borderWidth": 2,
            ".borderColor": "Gray",
            "text": "Style C1 & C2"
        }
    ]
}
