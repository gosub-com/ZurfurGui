{
    ".controller": "Window",
    ".namespace": "ZurfurGui.Windows",
    ".backgroundColor": "${color.surface.overlay}",
    ".borderColor": "${color.surface.overlay.stroke}",
    ".borderRadius": "${radius.corner.large}",
    ".borderWidth": "${stroke.width.medium}",
    ".sizeMin": "${size.window.min}",
    ".content": [
        {
            ".layout": "Dock",
            ".content": [
                {
                    ".name": "_windowTitle",
                    ".padding": "${spacing.vertical.small | spacing.horizontal.medium}",
                    ".backgroundColor": "${color.window.title.background}",
                    ".borderRadius": "${radius.corner.large.inside}",
                    ".layout": "Dock",
                    ".align": "vertical:top",
                    "dock.align": "top",
                    ".content": [
                        {
                            ".controller": "TextView",
                            "dock.align": "left",
                            "text": "≡",
                            "TextView.font": "${font.size.window.title}",
                            "TextView.color": "${color.window.menu | color.window.title.foreground}"
                        },
                        {
                            ".name": "_closeButton",
                            ".controller": "TextView",
                            "dock.align": "right",
                            "text": "X",
                            "TextView.font": "${font.size.window.title}",
                            "TextView.color": "${color.window.close | color.window.title.foreground}"
                        },
                        {
                            ".controller": "TextView",
                            ".name": "_title",
                            ".align": "horizontal:center,vertical:center",
                            "text": "(not set)",
                            "TextView.color": "${color.window.menu | color.window.title.foreground}",
                            "TextView.font": "${font.size.window.title}"

                        }
                    ]
                },
                {
                    ".name": "_windowContent",
                    ".clip": true,
                    ".margin": "${spacing.window | spacing.large}"
                }
            ]
        },
        {
            ".name": "_resizeHandle",
            ".align": "horizontal:right,vertical:bottom",
            ".margin": "left:0,top:0,right:-5,bottom:-13",
            ".content": [
                {
                    ".controller": "TextView",
                    "text": "◢",
                    ".offset": "x:-0.5,y:-1",
                    "font": "size:32"
                }
            ]
        }
    ]
}