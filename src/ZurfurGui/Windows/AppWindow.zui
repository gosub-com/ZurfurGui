{
	// The AppWindow is either the main browser window, or a canvas inside a web page,
	// or the computer desktop when running as a native applications.   It is the root 
	// of the view tree and holds global app state.
	// 
	// It holds all the other windows:
	//     MainAppView: The background app contained in the browser, canvas, or desktop application.
	//     FloatingWindows: Modal and modeless windows that can be moved around by the user.
	$controller: "AppWindow",
	$namespace: "ZurfurGui.Windows",
	$backgroundColor: "${color.surface.canvas}",
	AppWindow.longClickDuration: "${input.long-click.duration}",
	AppWindow.longClickMovementTolerance: "${input.long-click.movement-tolerance}",
	$data: {
		// The duration of a long click (press and hold) before it is recognized as a long click.
		longClickDuration: {
			type: "TimeSpan",
			bind: "styled"
		},
		// The maximum movement allowed during a long click before it is canceled.
		longClickMovementTolerance: {
			type: "double",
			bind: "styled"
		},
		// This is a styled test
		styledTest: {
			type: "double",
			bind: "styled"
		},
		// This is a styledData test
		styledDataTest: {
			type: "double",
			bind: "styledData"
		},
		// This is a data test
		dataTest: {
			type: "double",
			bind: "data"
		},
		// This is a property test
		propertyTest: {
			type: "double",
			bind: "property"
		},
	},
	$content: [
		{
			// Main App Window
			$name: "_mainAppView"
		},
		{
			// Floating windows, and dialogs on top
			$name: "_floatingWindows"
		}
	]
}
