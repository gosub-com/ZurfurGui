{
    $controller: "ScrollViewer",
    $namespace: "ZurfurGui.Controls",
    "ScrollViewer.wheelSteps": "${scroll.wheel.steps}",
    $data: {
        scrollSize: {
            type: "SizeProp",
            bind: "data",
            default: "new SizeProp(16, 16)"
        },
        scrollMode: {
            type: "ScrollMode",
            bind: "data",
            default: "ScrollMode.both"
        },
        autoScrollToEnd: {
            type: "bool",
            bind: "styled",
            default: false,
            flags: "measure"
        },
        wheelSteps: {
            type: "double",
            bind: "styled",
            default: 3
        }
    },
    $content: [
        {
            $name: "_contentViewport",
            $controller: "Panel",
            $clip: true,
            $align: "horizontal:stretch,vertical:stretch",
            $content: [
                {
                    $name: "_contentWindow",
                    $controller: "Panel",
                    $align: "horizontal:stretch,vertical:stretch"
                }
            ]
        },
        {
            $name: "horizontalScrollBar",
            $controller: "ScrollBar",
            orientation: "Horizontal",
            $sizeRequest: "height:16",
            $align: "horizontal:stretch,vertical:bottom"
        },
        {
            $name: "verticalScrollBar",
            $controller: "ScrollBar",
            orientation: "Vertical",
            $sizeRequest: "width:16",
            $align: "horizontal:right,vertical:stretch"
        }
    ]
}
