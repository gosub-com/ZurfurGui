{
    $controller: "TextView",
    $namespace: "ZurfurGui.Controls",
    TextView.color: "${color.text.primary}",
    $data: {
        text: {
            type: "TextLines",
            flags: "render,measure",
            bind: "data"
        },
        font: {
            type: "?FontProp",
            flags: "render,measure",
            bind: "styled"
        },
        color: {
            type: "?Color",
            flags: "render",
            bind: "styled"
        }
    }
}