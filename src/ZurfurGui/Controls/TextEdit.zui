{
    $controller: "TextEdit",
    $namespace: "ZurfurGui.Controls",
    $backgroundColor: "${color.input.background}",
    $borderWidth: "${stroke.width.default}",
    $borderColor: "${color.input.stroke}",
    $sizeMin: "${size.text-edit.min}",
    $padding: "${padding.text-edit}",
    $data: {
        text: {
            type: "TextLines",
            flags: "render,measure",
            bind: "data:_textContent.text"
        }
    },
    $content: [
        {
            $name: "_textContent",
            $controller: "TextView",
            TextView.color: "${color.text.primary}"
        }
    ]
}