{
    $controller: "ScrollBar",
    $namespace: "ZurfurGui.Controls",
    "ScrollBar.trackColor": "${color.scrollbar.track.background}",
    "ScrollBar.thumbColor": "${color.scrollbar.thumb.background}",
    "ScrollBar.thumbRadius": "${radius.scrollbar.thumb | spacing.extra-large}",
    "ScrollBar.thumbMinSize": "${size.scrollbar.thumb.min | spacing.extra-large}",
    "ScrollBar.thumbThickness": "${size.scrollbar.thumb.thickness | spacing.small}",
    "ScrollBar.thumbRestingThickness": "${size.scrollbar.thumb.resting-thickness | spacing.small}",
    "ScrollBar.thumbEdgeInset": "${size.scrollbar.thumb.edge-inset | spacing.extra-small}",
    $data: {
        // Current scroll position (ranges from Minimum to Maximum)
        value: {
            type: "Double",
            bind: "data",
            flags: "render"
        },

        // Minimum allowed value (typically 0)
        minimum: {
            type: "Double",
            bind: "data",
            flags: "render"
        },

        // Maximum allowed value (typically contentSize - viewportSize)
        maximum: {
            type: "Double",
            bind: "data",
            flags: "render"
        },

        // Size of the visible viewport (used to calculate thumb size)
        viewportSize: {
            type: "Double",
            flags: "render",
            bind: "data"
        },

        // Amount to scroll on wheel or arrow click
        smallChange: {
            type: "Double",
            flags: "render",
            bind: "data"
        },

        // Amount to scroll on track click (page up/down)
        largeChange: {
            type: "Double",
            flags: "render",
            bind: "data"
        },

        // Controls whether the ScrollViewer displays this scrollbar automatically, always, or never.
        visibility: {
            type: "ScrollBarVisibility",
            bind: "data",
            default: "ScrollBarVisibility.auto",
            flags: "measure,render"
        },

        // Horizontal or Vertical orientation
        orientation: {
            type: "Orientation",
            bind: "styledData",
            default: "Orientation.horizontal",
            flags: "render,measure"
        },

        // Appearance properties (styled)
        thumbColor: {
            type: "Color",
            bind: "styled",
            flags: "render"
        },
        trackColor: {
            type: "Color",
            bind: "styled",
            flags: "render"
        },
        thumbMinSize: {
            type: "Double",
            bind: "styled",
            flags: "measure,render"
        },
        thumbThickness: {
            type: "Double",
            bind: "styled",
            flags: "render"
        },
        thumbRestingThickness: {
            type: "Double",
            bind: "styled",
            flags: "render"
        },
        thumbEdgeInset: {
            type: "Double",
            bind: "styled",
            flags: "render"
        },
        expandOnHover: {
            type: "Bool",
            bind: "styledData",
            flags: "render"
        },
        thumbRadius: {
            type: "Double",
            bind: "styled",
            flags: "render"
        },
        isExpanded: {
            type: "Bool",
            bind: "property",
            default: false,
            flags: "style,render"
        }

    },
    $content: []
}
