<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
	<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZurfurGuiGen\ZurfurGuiGen.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <AdditionalFiles Include="**\*.zui" />
    <AdditionalFiles Include="**\*.zth" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\docs\**\*.md">
      <Pack>true</Pack>
      <PackagePath>contentFiles\any\any\docs\</PackagePath>
      <PackageCopyToOutput>false</PackageCopyToOutput>
      <BuildAction>None</BuildAction>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ZurfurGui.WinForms" />
    <InternalsVisibleTo Include="ZurfurGui.Browser" />
  </ItemGroup>

</Project>
